#!/bin/sh
# Every commit passes `runner check-all` first (ADR 12 item 15): ruff, format, mypy,
# translations, layout and the full suite. Commits that only touch docs/ or tasks/ skip it;
# the runner's own commits use --no-verify, since they're gated their own way.
# Installed with: git config core.hooksPath .factory/hooks
#
# Git runs hooks with GIT_INDEX_FILE and friends set. Leave them: `commit -a` stages into
# that index, and `check-all --hook` reads it to skip docs-only commits, then clears them
# itself so the runner tests' git commands can't write into this commit's index.
exec uv run runner check-all --hook
